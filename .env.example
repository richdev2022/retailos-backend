# =====================================
# RetailOS Backend - Environment Config
# =====================================
# Copy this file to .env and adjust the values.

# --- App ---
NODE_ENV=development
PORT=4000
APP_NAME=RetailOS
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000
LOG_LEVEL=info

# --- Database ---
# Use postgresql in staging/prod. Use sqlite for quick local dev.
# DATABASE_URL="postgresql://retailos:retailos@localhost:5432/retailos?schema=public"
DATABASE_URL="file:./dev.db"

# --- Auth / JWT ---
JWT_ACCESS_SECRET=replace-with-strong-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-different-strong-random-string-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
REFRESH_TOKEN_COOKIE_NAME=retailos_rt
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Password hashing ---
# "argon2" or "bcrypt"
PASSWORD_HASHER=bcrypt
BCRYPT_ROUNDS=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20

# --- Multi-tenant defaults ---
DEFAULT_CURRENCY=NGN
DEFAULT_COUNTRY=NG
ENABLE_NEGATIVE_STOCK=false

# --- Subscription grace (days) ---
DEFAULT_GRACE_PERIOD_DAYS=7
DEFAULT_TRIAL_DAYS=14

# --- File storage (local by default) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- Redis (optional, used for rate limiting / queues if available) ---
REDIS_URL=

# --- Frontend URLs (used for email links if email is enabled later) ---
WEBAPP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
WEBSITE_BASE_URL=http://localhost:3000

# --- Flutterwave (card payments for subscription renewals) ---
# Set FLW_ENABLED=true to enable card endpoints (POST /payments/cards, /payments/charge, ...)
# When false, those endpoints return 503 SERVICE_UNAVAILABLE.
FLW_ENABLED=false
# Secret key (server-to-server). Get from https://dashboard.flutterwave.com/dashboard/settings/apis
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxx-X
# Public key (sent to webapp for inline JS SDK)
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxx-X
# Encryption key (only needed for v2 card encryption; v3 tokenized charges don't need it)
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxx
# Webhook secret hash (the `verif-hash` header value Flutterwave sends).
# Set this in your Flutterwave dashboard under Webhooks.
FLW_WEBHOOK_HASH=your-webhook-verification-hash
# Branding shown on the Flutterwave payment modal
FLW_TITLE=RetailOS Subscription
FLW_LOGO_URL=https://app.retailos.com/logo.png

# --- Email (SMTP) ---
# Set EMAIL_ENABLED=true + SMTP_URL to actually send emails.
# When false, emails are written to the email_logs table with status=QUEUED
# and a debug log is emitted.
EMAIL_ENABLED=false
# SMTP connection URL. Format: smtps://user:pass@host:port or smtp://user:pass@host:port
SMTP_URL=
EMAIL_FROM=RetailOS <noreply@retailos.com>
EMAIL_FROM_NAME=RetailOS
EMAIL_REPLY_TO=support@retailos.com

# --- Brevo (formerly Sendinblue) — transactional emails + SMS ---
# Set BREVO_ENABLED=true to send all transactional emails + SMS through Brevo.
# When false, emails are written to the email_logs table with status=QUEUED
# and a debug log is emitted (no real email is sent).
BREVO_ENABLED=false
# API key — get from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Brevo API base URL (defaults to v3 — change only if you need a different version)
BREVO_BASE_URL=https://api.brevo.com/v3
# Sender email — MUST be a verified sender in your Brevo account
BREVO_SENDER_EMAIL=noreply@retailos.com
# Sender display name
BREVO_SENDER_NAME=RetailOS
# Reply-to email (where replies go)
BREVO_REPLY_TO=support@retailos.com
# Brevo SMS sender name (must be a registered sender — typically your business name)
BREVO_SMS_SENDER=RetailOS
